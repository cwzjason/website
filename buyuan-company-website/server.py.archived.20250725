# AI 配置持久化文件
AI_CONFIG_FILE = BASE_DIR / "ai_config.json"

def load_ai_config():
    """加载当前选中的供应商和模型"""
    if AI_CONFIG_FILE.exists():
        try:
            with open(AI_CONFIG_FILE, "r", encoding="utf-8") as f:
                cfg = json.load(f)
            prov = cfg.get("provider", "deepseek")
            model = cfg.get("model", "deepseek-chat")
            # 校验是否合法
            if prov in AI_PROVIDERS and any(m["id"] == model for m in AI_PROVIDERS[prov]["models"]):
                return prov, model
        except Exception:
            pass
    return "deepseek", "deepseek-chat"

def save_ai_config(provider, model):
    """持久化 AI 供应商/模型选择"""
    with open(AI_CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump({"provider": provider, "model": model}, f, ensure_ascii=False)

def get_api_key(provider):
    """获取供应商 API Key"""
    prov = AI_PROVIDERS.get(provider)
    if not prov:
        return ""
    return os.environ.get(prov["api_key_env"], "")

def get_base_url(provider):
    """获取供应商 Base URL"""
    prov = AI_PROVIDERS.get(provider)
    if not prov:
        return ""
    # 其他AI供应商支持环境变量覆盖
    if "base_url_env" in prov:
        return os.environ.get(prov["base_url_env"], prov["base_url"])
    return prov["base_url"]

