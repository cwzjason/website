| 平台结算折扣率 | 平台折扣率配置 |

## 你的能力（都是对真实数据库的操作，不是生成示例）
1. **插入数据**: 用户说"在销售表加一条"、"记一笔流水"等，提取表格名 + 各列值，调用 insert_table_row
2. **查询数据**: 用户问"销售表有哪些"、"湖北的客户"等，调用 query_table
3. **搜索**: 用户说"查一下包含xxx的记录"，在指定表调用 search_table
4. **修改数据**: 用户说"把编号xxx的金额改成"、"更新某条记录"等，先查到该记录的 _id，再调用 update_table_row
5. **删除**: 用户说"删掉id为xxx的那条"，调用 delete_row（删除前务必确认 _id）
6. **分析**: 基于真实查询结果做汇总、统计、对比分析

## 可用工具
- `describe_table(table_name)`: 查看指定表格的列结构、说明和示例数据。不确定列名时务必先调用。
- `insert_table_row(table_name, row_data)`: 向真实表格插入一行数据。
- `query_table(table_name)`: 查询表格真实数据。
- `search_table(table_name, keyword)`: 在真实表格中模糊搜索。
- `update_table_row(row_id, row_data)`: 修改指定 _id 记录的字段。修改前需先查到该记录的 _id。
- `delete_row(row_id)`: 删除指定 _id 的记录（删除前务必确认 _id）。
- `get_statistics()`: 获取每日流水统计。

## 规则
- **所有增删改查都必须真实调用工具操作数据库，严禁编造、虚构或生成示例数据**。你只能操作工具返回的真实数据。
- 日期未指定默认今天（{today}）
- 金额用数字，不需要千分位逗号
- 不确定表结构时，**先调用 describe_table 查看列名和示例**，再操作
- 修改/删除前必须先用 query_table 或 search_table 查到目标记录的 `_id`，绝不允许猜测 id
- 回复简洁友好，操作成功后告诉用户：对哪张表、哪条记录、做了什么
- Excel/图片上传时仔细阅读内容，可批量导入
- 如果用户没指定表格名，根据内容判断最合适的表格

当前日期：{today}"""

# ============================================================================
# Function Tools —— 统一为 insert_table_row / search_table / query_table / delete_row
# ============================================================================
def build_table_tools():
    tools = [
        {
            "type": "function",
            "function": {
                "name": "insert_table_row",
                "description": "向任意业务表格插入一行数据。table_name 必须是以下之一：销售表、采购成本表、收款表、费用表、利润表、承包确认单、客户统计表、每日流水、平台结算折扣率。row_data 是一个 JSON 对象，键为列名，值为对应的数据。",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "table_name": {
                            "type": "string",
                            "description": "表格名称，如：销售表、采购成本表、收款表、费用表、利润表、承包确认单、客户统计表、每日流水、平台结算折扣率"
                        },
                        "_removed_col": {
                            "type": "object",
                            "description": "行数据，key 为列名，value 为值。例如 销售表: {\"编号\":\"1\",\"订单日期\":\"2026-07-23\",\"收料单位\":\"武汉\",\"供应商名称\":\"张三\",\"商品名称\":\"拖把\",\"品牌\":\"埠乐\",\"单位\":\"个\",\"数量\":\"5\",\"单价（含税）\":\"10\",\"合计（含税）\":\"50\"}"
                        }
                    },
                    "required": ["table_name", "_removed_col"]
                }
            }
        },
        {
            "type": "function",
            "function": {
                "name": "query_table",
                "description": "查询指定表格的所有数据",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "table_name": {
                            "type": "string",
                            "description": "表格名称"
                        },
                        "limit": {
                            "type": "integer",
                            "description": "返回条数，默认50"
                        }
                    },
                    "required": ["table_name"]
                }
            }
        },
        {
            "type": "function",
            "function": {
                "name": "search_table",
                "description": "在指定表格中模糊搜索关键词",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "table_name": {
                            "type": "string",
                            "description": "表格名称"
                        },
                        "keyword": {
                            "type": "string",
                            "description": "搜索关键词"
                        }
                    },
                    "required": ["table_name", "keyword"]
                }
            }
        },
        {
            "type": "function",
            "function": {
                "name": "delete_row",
                "description": "删除指定 ID 的记录。需要先查表确认 ID。",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "row_id": {
                            "type": "integer",
                            "description": "要删除的记录 ID（_id）"
                        }
                    },
                    "required": ["row_id"]
                }
            }
        },
        {
            "type": "function",
            "function": {
                "name": "update_table_row",
                "description": "修改指定记录的字段值。修改前必须先通过 query_table 或 search_table 查到目标记录的 _id。",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "row_id": {
                            "type": "integer",
                            "description": "要修改的记录 ID（_id）"
                        },
                        "_removed_col": {
                            "type": "object",
                            "description": "要更新的字段，key 为列名，value 为新值。例如 {\"合计（含税）\":\"80\",\"数量\":\"8\"}"
                        }
                    },
                    "required": ["row_id", "_removed_col"]
                }
            }
        },
        {
            "type": "function",
            "function": {
                "name": "get_statistics",
                "description": "获取每日流水的统计信息（总额、分类汇总）",
                "parameters": {"type": "object", "properties": {}}
            }
        },
        {
            "type": "function",
            "function": {
                "name": "describe_table",
                "description": "查看指定表格的列结构、说明和最近示例数据。在不确定列名或需要了解表结构时调用。",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "table_name": {
                            "type": "string",
                            "description": "表格名称，如：销售表、采购成本表、收款表、费用表、利润表、承包确认单、客户统计表、每日流水、平台结算折扣率"
                        },
                        "include_sample": {
                            "type": "boolean",
                            "description": "是否返回示例数据，默认 true"
                        }
                    },
                    "required": ["table_name"]
                }
            }
        },
    ]
    return tools

TOOLS = build_table_tools()

# ============================================================================
# 聊天历史
# ============================================================================
def save_chat(role, content):
    conn = get_db()
    c = conn.cursor()
    c.execute("INSERT INTO chat_history (role, content) VALUES (?,?)", (role, content))
    # 清理超过 1 天的旧记录（保留一天历史）
    c.execute("DELETE FROM chat_history WHERE created_at < datetime('now', '-1 day')")
    conn.commit()
    conn.close()

def load_chat_history(limit=10):
    conn = get_db()
    conn.row_factory = None
    c = conn.cursor()
    c.execute("SELECT role, content FROM chat_history ORDER BY id ASC LIMIT ?", (limit,))
    rows = [{"role": r["role"], "content": r["content"]} for r in c.fetchall()]
    conn.close()
    return list(reversed(rows))

def get_recent_chat_history(hours=24):
    """返回最近 N 小时内的聊天记录（正序，供前端展示），并清理过期记录"""
    conn = get_db()
    conn.row_factory = None
    c = conn.cursor()
    # 清理过期记录
    c.execute("DELETE FROM chat_history WHERE created_at < datetime('now', '-1 day')")
    # 只取最近 N 小时
    c.execute(
        "SELECT role, content, created_at FROM chat_history WHERE created_at >= datetime('now', ?) ORDER BY id ASC",
        (f"-{hours} hours",)
    )
    rows = [{"role": r["role"], "content": r["content"], "created_at": r["created_at"]} for r in c.fetchall()]
    conn.commit()
    conn.close()
    return rows

