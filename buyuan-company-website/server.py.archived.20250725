# ========== 表格版本号（用于实时同步） ==========
_table_versions = {}  # {table_name: int}  每次写入递增

def _load_versions_from_db():
    try:
        conn = pymysql.connect(**DB_CONFIG)
        c = conn.cursor()
        c.execute("SELECT table_name, version FROM table_meta")
        result = {row["table_name"]: row["version"] for row in c.fetchall()}
        conn.close()
        return result
    except Exception:
        return {}

_table_versions = _load_versions_from_db()  # 从数据库恢复

def _bump_version(table_name: str):
    """递增表格版本号"""
    new_v = _table_versions.get(table_name, 0) + 1
    _table_versions[table_name] = new_v
    try:
        conn = get_db()
        with conn.cursor() as c2:
        c2.execute(
            "INSERT INTO table_meta(table_name,version) VALUES(%s,%s) ON DUPLICATE KEY UPDATE version=%s",
            (table_name, new_v, new_v)
        )
        conn.commit()
        conn.close()
    except Exception:
        pass

