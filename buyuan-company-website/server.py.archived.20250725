@app.route("/api/ai/models", methods=["GET"])
def list_ai_models():
    """列出所有 AI 供应商及其模型"""
    prov_key, cur_model = load_ai_config()
    providers = []
    for pk, p in AI_PROVIDERS.items():
        api_ok = bool(get_api_key(pk))
        providers.append({
            "id": pk,
            "name": p["name"],
            "icon": p.get("icon", ""),
            "api_ok": api_ok,
            "models": [{"id": m["id"], "name": m["name"], "desc": m["desc"]} for m in p["models"]]
        })
    return jsonify({
        "providers": providers,
        "current_provider": prov_key,
        "current_model": cur_model
    })

@app.route("/api/ai/config", methods=["GET"])
def get_ai_config():
    """获取当前 AI 配置"""
    prov_key, cur_model = load_ai_config()
    prov = AI_PROVIDERS.get(prov_key, {})
    return jsonify({
        "provider": prov_key,
        "provider_name": prov.get("name", ""),
        "provider_icon": prov.get("icon", ""),
        "model": cur_model,
        "model_name": next((m["name"] for m in prov.get("models", []) if m["id"] == cur_model), cur_model),
        "api_ok": bool(get_api_key(prov_key)),
        "api_key_env": prov.get("api_key_env", ""),
    })

@app.route("/api/ai/config", methods=["POST"])
def set_ai_config():
    """切换 AI 供应商/模型"""
    data = request.get_json(force=True, silent=True) or {}
    provider = data.get("provider", "").strip()
    model_id = data.get("model", "").strip()

    if provider not in AI_PROVIDERS:
        return jsonify({"error": f"未知供应商: {provider}, 可选: {list(AI_PROVIDERS.keys())}"}), 400

    prov = AI_PROVIDERS[provider]
    valid_models = [m["id"] for m in prov["models"]]
    if model_id not in valid_models:
        return jsonify({"error": f"模型 {model_id} 不在 {prov['name']} 中, 可选: {valid_models}"}), 400

    if not get_api_key(provider):
        return jsonify({"error": f"{prov['name']} 未配置 API Key (需设置环境变量 {prov['api_key_env']})"}), 400

    save_ai_config(provider, model_id)
    return jsonify({
        "success": True,
        "provider": provider,
        "provider_name": prov["name"],
        "model": model_id,
        "model_name": next((m["name"] for m in prov["models"] if m["id"] == model_id), model_id),
    })

@app.route("/api/health", methods=["GET"])
def health():
    prov_key, cur_model = load_ai_config()
    prov = AI_PROVIDERS.get(prov_key, {})
    return jsonify({
        "status": "ok",
        "provider": prov_key,
        "provider_name": prov.get("name", ""),
        "model": cur_model,
        "has_api_key": bool(get_api_key(prov_key))
    })

@app.route("/api/chat", methods=["POST"])
def chat():
    try:
        text = request.form.get("message", "")
        file = request.files.get("file")
        if not text and not file:
            return jsonify({"error": "请提供消息或文件"}), 400

        today = datetime.now().strftime("%Y-%m-%d")
        today_time = datetime.now().strftime("%Y-%m-%d %H:%M")

        messages = []
        user_content = []
        file_info = ""

        # 处理上传文件
        if file:
            file_bytes = file.read()
            filename = file.filename or ""
            ext = Path(filename).suffix.lower() if filename else ""

            if ext in (".xlsx", ".xls"):
                excel_text = parse_excel(file_bytes, filename)
                file_info = f"\n\n【用户上传了 Excel: {filename}】\n{excel_text}"
            elif ext in (".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp"):
                img_result = parse_image(file_bytes)
                file_info = f"\n\n【用户上传了图片: {filename}】\n{img_result['text']}"
                b64 = base64.b64encode(file_bytes).decode("utf-8")
                mime = f"image/{ext.lstrip('.')}"
                if ext == ".jpg": mime = "image/jpeg"
                user_content.append({
                    "type": "image_url",
                    "image_url": {"url": f"data:{mime};base64,{b64}"}
                })
            else:
                try:
                    text_content = file_bytes.decode("utf-8")
                    file_info = f"\n\n【用户上传了文件: {filename}】\n{text_content}"
                except:
                    file_info = f"\n\n【用户上传了文件: {filename}（无法解析）】"

        # 系统提示
        messages.append({"role": "system", "content": SYSTEM_PROMPT.format(today=today)})

        # 历史对话
        history = load_chat_history(10)
        for h in history:
            messages.append({"role": h["role"], "content": h["content"]})

        # 当前消息
        if user_content:
            user_content.insert(0, {"type": "text", "text": text + file_info if text else file_info})
            messages.append({"role": "user", "content": user_content})
        else:
            messages.append({"role": "user", "content": text + file_info if file_info else text})

        save_chat("user", text or f"[上传文件: {file.filename if file else '未知'}]")

        # 多轮工具调用循环：支持 AI 多步推理与操作（如先查后改/删）
        actions = []
        reply = ""
        MAX_TOOL_ROUNDS = 6
        for _round in range(MAX_TOOL_ROUNDS):
            result = call_deepseek(messages, tools=TOOLS)
            if "error" in result:
                if _round == 0:
                    return jsonify({"reply": f"AI 服务暂时不可用: {result['error']}", "actions": []}), 500
                reply = msg.get("content") or reply or "操作部分完成，但 AI 后续响应失败。"
                break

            msg = result["choices"][0]["message"]

            # 处理 function calling（标准 OpenAI 格式 或 DSML 文本格式）
            raw_tool_calls = msg.get("tool_calls") or []
            # 对 DeepSeek-R1 等模型，工具调用可能以 DSML/XML 文本形式输出
            if not raw_tool_calls and isinstance(msg.get("content"), str):
                dsml_calls = parse_dsml_tool_calls(msg["content"])
                if dsml_calls:
                    raw_tool_calls = [
                        {
                            "id": f"call_dsml_{i}",
                            "function": {"name": c["name"], "arguments": json.dumps(c["arguments"], ensure_ascii=False)},
                            "type": "function"
                        }
                        for i, c in enumerate(dsml_calls)
                    ]
                # 移除原文中的 DSML 标记，避免重复显示
                msg["content"] = re.sub(
                    r'<[^>]*tool_calls[^>]*>.*?</[^>]*tool_calls[^>]*>',
                    '', msg["content"], flags=re.DOTALL
                ).strip()

            if not raw_tool_calls:
                reply = msg.get("content", "")
                break

            for tc in raw_tool_calls:
                func = tc.get("function", {})
                func_name = func.get("name", "")
                args_str = func.get("arguments", "{}")
                try:
                    args = json.loads(args_str) if isinstance(args_str, str) else args_str
                except Exception:
                    args = {}
                tool_result = ""

                if func_name == "insert_table_row":
                    rec = insert_table_row(args["table_name"], args["_removed_col"])
                    if rec.get("_error"):
                        tool_result = json.dumps({"success": False, "error": f"编号 '{rec['_dup_bianhao']}' 在{rec['_table']}中已存在，不能重复"}, ensure_ascii=False)
                    else:
                        tool_result = json.dumps({"success": True, "table": args["table_name"], "row": rec}, ensure_ascii=False)
                        actions.append({"type": "insert", "table": args["table_name"], "row": rec})

                elif func_name == "query_table":
                    rows = query_table_rows(args["table_name"], args.get("limit", 50))
                    tool_result = json.dumps(rows, ensure_ascii=False, default=str)

                elif func_name == "search_table":
                    rows = search_table_rows(args["table_name"], args["keyword"], args.get("limit", 100))
                    tool_result = json.dumps(rows, ensure_ascii=False, default=str)

                elif func_name == "delete_row":
                    ok = delete_table_row(args["row_id"])
                    tool_result = json.dumps({"success": ok, "deleted_id": args["row_id"]}, ensure_ascii=False)

                elif func_name == "update_table_row":
                    upd = update_table_row(args["row_id"], args.get("_removed_col", {}))
                    if upd is None:
                        tool_result = json.dumps({"success": False, "error": f"未找到 _id={args['row_id']} 的记录，请先查询确认"}, ensure_ascii=False)
                    elif isinstance(upd, dict) and upd.get("_error"):
                        tool_result = json.dumps({"success": False, "error": f"编号 {upd.get('_dup_bianhao')} 在{upd.get('_table')}中已存在，不可重复"}, ensure_ascii=False)
                    else:
                        tool_result = json.dumps({"success": True, "updated_id": args["row_id"], "new_data": upd}, ensure_ascii=False, default=str)
                        actions.append({"type": "update", "table": args.get("table_name", ""), "row": upd})

                elif func_name == "get_statistics":
                    stats = get_stats()
                    tool_result = json.dumps(stats, ensure_ascii=False)

                elif func_name == "describe_table":
                    info = describe_table(args["table_name"], args.get("include_sample", True))
                    tool_result = json.dumps(info, ensure_ascii=False, default=str)

                else:
                    tool_result = json.dumps({"success": False, "error": f"未知工具: {func_name}"}, ensure_ascii=False)

                messages.append({
                    "role": "assistant",
                    "content": None,
                    "tool_calls": [tc]
                })
                messages.append({
                    "role": "tool",
                    "tool_call_id": tc.get("id", "call_1"),
                    "content": tool_result
                })
        else:
            # 达到最大轮数仍未结束（防止 AI 陷入工具循环）
            reply = (msg.get("content") or "") + "\n\n（已达到最大操作步数，如需继续请补充指令）"

        save_chat("assistant", reply)

        return jsonify({"reply": reply, "actions": actions, "time": today_time})

    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({"reply": f"处理出错: {str(e)}", "actions": []}), 500

@app.route("/api/chat/history", methods=["GET"])
def get_chat_history_api():
    """返回最近 24 小时的聊天历史（供前端持久化展示，一天后自动删除）"""
    hours = request.args.get("hours", default=24, type=int)
    records = get_recent_chat_history(hours)
    return jsonify({"history": records})

# ---- 前端数据同步 API ----
@app.route("/api/tables", methods=["GET"])
def get_all_tables_api():
    """返回所有表格数据（ALL_DATA 格式，供前端使用）"""
    return jsonify(get_all_tables())

@app.route("/api/tables/version", methods=["GET"])
def get_tables_version_api():
    """返回所有表格的版本号（轻量级，前端用于检测数据变化）"""
    return jsonify({k: _table_versions.get(k, 0) for k in TABLE_SCHEMAS})

@app.route("/api/tables/<table_name>", methods=["GET"])
def get_table_api(table_name):
    """获取指定表格数据"""
    if table_name not in TABLE_SCHEMAS:
        return jsonify({"error": f"未知表格: {table_name}"}), 404
    rows = query_table_rows(table_name)
    return jsonify({
        "headers": TABLE_SCHEMAS[table_name]["columns"],
        "rows": rows,
        "row_count": len(rows)
    })

@app.route("/api/tables/<table_name>", methods=["POST"])
def post_table_api(table_name):
    """插入一行到指定表格"""
    if table_name not in TABLE_SCHEMAS:
        return jsonify({"error": f"未知表格: {table_name}"}), 404
    data = request.get_json(force=True, silent=True) or {}
    rec = insert_table_row(table_name, data)
    if rec.get("_error"):
        return jsonify({"error": f"编号 '{rec['_dup_bianhao']}' 在{rec['_table']}中已存在，不能重复"}), 409
    _bump_version(table_name)
    return jsonify({"success": True, "row": rec})

@app.route("/api/tables/<table_name>/batch", methods=["POST"])
def batch_insert_api(table_name):
    """批量插入行"""
    if table_name not in TABLE_SCHEMAS:
        return jsonify({"error": f"未知表格: {table_name}"}), 404
    data = request.get_json(force=True, silent=True) or {}
    rows = data.get("rows", [])
    inserted = []
    dup_error = None
    for r in rows:
        rec = insert_table_row(table_name, r)
        if rec.get("_error"):
            dup_error = rec["_dup_bianhao"]
            break
        inserted.append(rec)
    if dup_error:
        _bump_version(table_name)
        return jsonify({"success": False, "error": f"编号 '{dup_error}' 已存在，不能重复。已导入 {len(inserted)} 条", "inserted": len(inserted)}), 409
    _bump_version(table_name)
    return jsonify({"success": True, "inserted": len(inserted), "rows": inserted})

@app.route("/api/tables/<table_name>/rows/delete", methods=["POST"])
def batch_delete_rows_api(table_name):
    """批量按编号删除行（数据库直接删除，不走全表同步）"""
    data = request.get_json(force=True, silent=True) or {}
    bianhaos = data.get("bianhaos", [])
    if not bianhaos:
        return jsonify({"success": False, "error": "未提供编号"}), 400
    conn = get_db()
    c = conn.cursor()
    deleted = 0
    for bh in bianhaos:
        bh_str = str(bh).strip()
        c.execute(
            "SELECT id FROM business_records WHERE json_extract(row_data, '$.编号') = ?",
            (table_name, bh_str)
        )
        for row in c.fetchall():
            c.execute("DELETE FROM business_records WHERE id=?", (row[0],))
            deleted += 1
    conn.commit()
    conn.close()
    _bump_version(table_name)
    new_version = _table_versions.get(table_name, 0)
    return jsonify({"success": True, "deleted": deleted, "version": new_version})

@app.route("/api/tables/<table_name>/sync", methods=["PUT"])
def sync_table_api(table_name):
    """全量替换同步：先清空再插入，支持删除操作（多人协作时注意最后保存者覆盖）"""
    if table_name not in TABLE_SCHEMAS:
        return jsonify({"error": f"未知表格: {table_name}"}), 404
    data = request.get_json(silent=True)
    if not data or "rows" not in data:
        return jsonify({"error": "缺少 rows 字段"}), 400

    rows = data["rows"]
    # 检查批次内是否有重复编号
    seen_bianhao = set()
    dup_bianhao = None
    for r in rows:
        if isinstance(r, dict):
            bh = str(r.get("编号", "")).strip()
            if bh:
                if bh in seen_bianhao:
                    dup_bianhao = bh
                    break
                seen_bianhao.add(bh)
    if dup_bianhao:
        return jsonify({"error": f"编号 '{dup_bianhao}' 在数据中重复出现，请修复后重新导入", "_dup_bianhao": dup_bianhao}), 409
    # 全量替换：先清空该表旧数据，再插入客户端最新数据（支持删除）
    columns = TABLE_SCHEMAS[table_name]["columns"]
    conn = get_db()
    c = conn.cursor()
    inserted = 0
    skipped = 0
    try:
        # 先删除该表所有旧数据
        c.execute(f"DELETE FROM `{table_name}`")
        deleted_count = c.rowcount

        # 再插入客户端最新数据
        for r in rows:
            if not isinstance(r, dict):
                skipped += 1
                continue
            # 过滤出表schema中定义的列，同时保留 _id 以便前端匹配
            filtered = {col: r.get(col, "") for col in columns if col in r}
            # 如果一行里所有列都为空，跳过
            all_empty = all(str(v).strip() == "" for v in filtered.values())
            if all_empty:
                skipped += 1
                continue
            row_json = json.dumps(filtered, ensure_ascii=False)
            c.execute("INSERT INTO business_records (table_name, row_data) VALUES (?, ?)", (table_name, row_json))
            inserted += 1
        conn.commit()
    except Exception as e:
        conn.rollback()
        conn.close()
        import traceback; traceback.print_exc()
        return jsonify({"error": f"同步失败: {str(e)}"}), 500
    conn.close()
    _bump_version(table_name)
    new_version = _table_versions.get(table_name, 0)
    return jsonify({"success": True, "inserted": inserted, "deleted_old": deleted_count, "skipped": skipped, "version": new_version})

@app.route("/api/records/<int:row_id>", methods=["PUT"])
def update_record_api(row_id):
    """更新单条记录"""
    data = request.get_json(silent=True)
    if not data:
        return jsonify({"error": "缺少数据"}), 400
    row = update_table_row(row_id, data)
    if row is None:
        return jsonify({"error": "记录不存在"}), 404
    if row.get("_error"):
        return jsonify({"error": f"编号 '{row['_dup_bianhao']}' 在{row['_table']}中已存在，不能重复"}), 409
    return jsonify({"success": True, "row": row})

def _match_columns(excel_headers, schema_cols):
    """匹配Excel列名到schema列名，返回 (col_map, score)
    优先精确匹配，再模糊匹配，避免 订单编号 被错误映射到 编号
    """
    col_map = {}
    matched_schema = set()

    # 第一轮：精确匹配（列名完全相同）
    for ei, eh in enumerate(excel_headers):
        if not eh:
            continue
        for sc in schema_cols:
            if eh == sc:
                col_map[ei] = sc
                matched_schema.add(sc)
                break

    # 第二轮：模糊匹配（包含关系），已匹配的 schema 列不再参与
    for ei, eh in enumerate(excel_headers):
        if not eh or ei in col_map:
            continue
        for sc in schema_cols:
            if sc in matched_schema:
                continue
            if eh in sc or sc in eh:
                col_map[ei] = sc
                matched_schema.add(sc)
                break

    return col_map, len(col_map)

def _find_best_header_and_sheet(wb, table_name):
    """在Excel所有工作表中找到最佳匹配的表头行（处理合并单元格）"""
    schema_cols = TABLE_SCHEMAS[table_name]["columns"]
    all_candidates = []

    for sn in wb.sheetnames:
        ws = wb[sn]
        raw_rows = list(ws.iter_rows(values_only=True))
        if len(raw_rows) < 2:
            continue

        # 尝试前4行作为候选表头行
        search_rows = min(4, len(raw_rows))
        for header_row_idx in range(search_rows):
            excel_headers = [str(c).strip() if c is not None else "" for c in raw_rows[header_row_idx]]
            col_map, score = _match_columns(excel_headers, schema_cols)
            if score > 0:
                all_candidates.append({
                    "sheet_name": sn,
                    "sheet": ws,
                    "header_row_idx": header_row_idx,
                    "headers": excel_headers,
                    "col_map": col_map,
                    "score": score,
                    "raw_rows": raw_rows
                })

        # 额外奖励：工作表名称匹配目标表名
        for c in all_candidates:
            if c["sheet_name"] == table_name:
                c["score"] += 100

    if not all_candidates:
        return None

    # 按分数降序排列，选最佳
    all_candidates.sort(key=lambda x: -x["score"])
    return all_candidates[0]

@app.route("/api/tables/<table_name>/import", methods=["POST"])
def excel_import_api(table_name):
    """Excel 批量导入到指定表格"""
    if table_name not in TABLE_SCHEMAS:
        return jsonify({"error": f"未知表格: {table_name}"}), 404

    if "file" not in request.files:
        return jsonify({"error": "请上传文件"}), 400

    f = request.files["file"]
    if not f.filename:
        return jsonify({"error": "文件名为空"}), 400

    ext = Path(f.filename).suffix.lower()
    if ext not in (".xlsx", ".xls"):
        return jsonify({"error": "仅支持 .xlsx / .xls 文件"}), 400

    try:
        file_bytes = f.read()
        wb = load_workbook(io.BytesIO(file_bytes), data_only=True)

        best = _find_best_header_and_sheet(wb, table_name)
        if best is None:
            schema_cols = TABLE_SCHEMAS[table_name]["columns"]
            return jsonify({
                "error": "列名无法匹配。表格要求的列: " + ", ".join(schema_cols[:12]) +
                         "。请检查Excel表头是否包含这些列名"
            }), 400

        ws = best["sheet"]
        col_map = best["col_map"]
        raw_rows = best["raw_rows"]
        header_row_idx = best["header_row_idx"]
        excel_headers = best["headers"]

        # 从表头行下一行开始解析数据
        parsed_rows = []
        skipped = 0
        for raw_row in raw_rows[header_row_idx + 1:]:
            row_data = {}
            has_value = False
            for ei, cell_value in enumerate(raw_row):
                sc = col_map.get(ei)
                if sc:
                    val = str(cell_value).strip() if cell_value is not None else ""
                    row_data[sc] = val
                    if val:
                        has_value = True
            if has_value:
                parsed_rows.append(row_data)
            else:
                skipped += 1

        if not parsed_rows:
            return jsonify({"error": "没有解析到有效数据行"}), 400

        inserted = []
        dup_skipped = []
        for r in parsed_rows:
            rec = insert_table_row(table_name, r)
            if rec.get("_error"):
                dup_skipped.append(rec["_dup_bianhao"])
            else:
                inserted.append(rec)
        _bump_version(table_name)
        new_version_import = _table_versions.get(table_name, 0)

        result = {
            "success": True,
            "version": new_version_import,
            "skipped": skipped,
            "inserted": len(inserted),
            "sheet_used": best["sheet_name"],
            "header_row": header_row_idx + 1,
            "matched_columns": {list(excel_headers)[k]: list(col_map.values())[i]
                                for i, k in enumerate(col_map) if k < len(excel_headers)},
            "rows": inserted
        }
        if dup_skipped:
            result["dup_skipped"] = dup_skipped
            result["warning"] = f"以下编号已存在被跳过({len(dup_skipped)}条): {', '.join(dup_skipped[:10])}" + ("..." if len(dup_skipped) > 10 else "")
        return jsonify(result)

    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({"error": f"解析失败: {str(e)}"}), 500

@app.route("/api/records/<int:row_id>", methods=["DELETE"])
def delete_row_api(row_id):
    """删除指定行"""
    # 先查表名，再删除
    conn = get_db()
    c = conn.cursor()
    c.execute("SELECT table_name FROM business_records WHERE id=?", (row_id,))
    row = c.fetchone()
    conn.close()
    tname = row[0] if row else None
    ok = delete_table_row(row_id)
    if ok and tname:
        _bump_version(tname)
    return jsonify({"success": ok})

@app.route("/api/records/<int:row_id>", methods=["PUT"])
def update_row_api(row_id):
    """更新指定行"""
    # 先查表名
    conn = get_db()
    c = conn.cursor()
    c.execute("SELECT table_name FROM business_records WHERE id=?", (row_id,))
    row = c.fetchone()
    conn.close()
    tname = row[0] if row else None
    data = request.get_json(force=True, silent=True) or {}
    rec = update_table_row(row_id, data)
    if rec is None:
        return jsonify({"error": "记录不存在"}), 404
    if rec.get("_error"):
        return jsonify({"error": f"编号 '{rec['_dup_bianhao']}' 在{rec['_table']}中已存在，不能重复"}), 409
    if tname:
        _bump_version(tname)
    return jsonify({"success": True, "row": rec})

