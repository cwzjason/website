# ============================================================================
# 数据库初始化
# ============================================================================
def get_db():
    return pymysql.connect(**DB_CONFIG)

    try:

def init_db():
    conn = get_db()
    c = conn.cursor()
    try:
        c.execute("SELECT 1")
        c.execute("SELECT 1")
        c.execute("SELECT 1")
    except Exception:
        pass

    # 统一业务记录表：table_name 区分不同表格，row_data 存 JSON
    c.execute('''
        CREATE TABLE IF NOT EXISTS table_meta (
            table_name VARCHAR(100) PRIMARY KEY,
            version INTEGER DEFAULT 0
        )
    ''')
    c.execute('''
        CREATE TABLE IF NOT EXISTS business_records (
            id INTEGER PRIMARY KEY AUTO_INCREMENT,
            table_name TEXT NOT NULL,
            row_data TEXT NOT NULL DEFAULT '{}',
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    c.execute('CREATE INDEX IF NOT EXISTS idx_table_name ON business_records(table_name)')
    try:
        c.execute('''
            CREATE UNIQUE INDEX IF NOT EXISTS idx_unique_bianhao
            ON business_records(table_name, json_extract(row_data, "$.编号"))
            WHERE json_extract(row_data, "$.编号") IS NOT NULL
              AND json_extract(row_data, "$.编号") != ""
        ''')
    except Exception as e:
        print(f"[WARN] 无法创建编号唯一索引: {e}")
        conn.rollback()

    # 原有 daily_records（兼容旧数据）
    c.execute('''
        CREATE TABLE IF NOT EXISTS daily_records (
            id INTEGER PRIMARY KEY AUTO_INCREMENT,
            date TEXT NOT NULL,
            category TEXT DEFAULT '',
            item TEXT DEFAULT '',
            amount REAL DEFAULT 0,
            remark TEXT DEFAULT '',
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')

    # 聊天历史
    c.execute('''
        CREATE TABLE IF NOT EXISTS chat_history (
            id INTEGER PRIMARY KEY AUTO_INCREMENT,
            role TEXT NOT NULL,
            content TEXT NOT NULL,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')

    conn.commit()
    conn.close()

init_db()

# ============================================================================
# 业务表格 CRUD
# ============================================================================
def insert_table_row(table_name: str, row_data: dict) -> dict:
    """向指定表格插入一行，编号不可重复"""
    columns = TABLE_SCHEMAS.get(table_name, {}).get("columns", [])
    # 只保留有效列
    filtered = {}
    for col in columns:
        if col in row_data:
            filtered[col] = row_data[col]

    # 检查编号是否重复
    bianhao = str(filtered.get("编号", "")).strip()
    if bianhao:
        conn = get_db()
        c = conn.cursor()
        c.execute(
            "SELECT id FROM business_records WHERE json_extract(row_data, '$.编号')=?",
            (table_name, bianhao)
        )
        if c.fetchone():
            conn.close()
            return {"_error": True, "_dup_bianhao": bianhao, "_table": table_name}
        conn.close()

    conn = get_db()
    c = conn.cursor()
    c.execute(
        "INSERT INTO business_records (table_name, row_data) VALUES (?, ?)",
        (filtered,)
    )
    row_id = c.lastrowid
    conn.commit()
    conn.close()
    filtered["_id"] = row_id
    return filtered

def query_table_rows(table_name: str, limit: int = 100000) -> list:
    """查询指定表格的所有行"""
    conn = get_db()
    conn.row_factory = None
    c = conn.cursor()
    c.execute(
        "SELECT id, row_data, created_at FROM business_records WHERE table_name=? ORDER BY id ASC LIMIT ?",
        (table_name, limit)
    )
    rows = []
    for r in c.fetchall():
        d = dict(r)
        d["_id"] = r["id"]
        d["_created_at"] = r["created_at"]
        rows.append(d)
    conn.close()
    return list(reversed(rows))

def delete_table_row(row_id: int) -> bool:
    """删除指定行"""
    conn = get_db()
    c = conn.cursor()
    c.execute("DELETE FROM business_records WHERE id=?", (row_id,))
    affected = c.rowcount
    conn.commit()
    conn.close()
    return affected > 0

def get_table_row_count(table_name):
    """获取指定表的行数"""
    conn = get_db()
    c = conn.cursor()
    c.execute(f"SELECT COUNT(*) FROM `{table_name}`")
    count = c.fetchone()[0]
    conn.close()
    return count

def clear_table_rows(table_name: str):
    """清空指定表格所有行"""
    conn = get_db()
    c = conn.cursor()
    c.execute(f"DELETE FROM `{table_name}`")
    conn.commit()
    conn.close()

def update_table_row(row_id: int, row_data: dict) -> dict:
    """更新指定行，编号不可与其它行重复"""
    conn = get_db()
    c = conn.cursor()
    c.execute("SELECT table_name, row_data FROM business_records WHERE id=?", (row_id,))
    old = c.fetchone()
    if not old:
        conn.close()
        return None
    tname = old[0]
    old_data = json.loads(old[1])
    new_data = old_data.copy()
    new_data.update(row_data)

    # 检查编号是否与其它行冲突
    new_bianhao = str(new_data.get("编号", "")).strip()
    if new_bianhao:
        c.execute(
            "SELECT id FROM business_records WHERE json_extract(row_data, '$.编号')=? AND id!=?",
            (tname, new_bianhao, row_id)
        )
        if c.fetchone():
            conn.close()
            return {"_error": True, "_dup_bianhao": new_bianhao, "_table": tname}

    c.execute(
        "UPDATE business_records SET row_data=? WHERE id=?",
        (json.dumps(new_data, ensure_ascii=False), row_id)
    )
    conn.commit()
    conn.close()
    new_data["_id"] = row_id
    return new_data

def get_all_tables() -> dict:
    """获取所有表格的全部数据（返回 ALL_DATA 格式供前端使用）"""
    result = {}
    conn = get_db()
    conn.row_factory = None
    c = conn.cursor()
    for tname, schema in TABLE_SCHEMAS.items():
        c.execute(
            "SELECT id, row_data FROM business_records WHERE table_name=? ORDER BY id ASC",
            (tname,)
        )
        rows = []
        for r in c.fetchall():
            d = dict(r)
            d["_id"] = r["id"]
            rows.append(d)
        result[tname] = {
            "headers": schema["columns"],
            "rows": rows,
            "row_count": len(rows),
            "version": _table_versions.get(tname, 0)
        }
    conn.close()
    return result

def search_table_rows(table_name: str, keyword: str, limit: int = 100000) -> list:
    """模糊搜索表格内容"""
    conn = get_db()
    conn.row_factory = None
    c = conn.cursor()
    # SQLite 全表扫描 + JSON 模糊匹配
    c.execute(
        "SELECT id, row_data FROM business_records WHERE row_data LIKE ? ORDER BY id ASC LIMIT ?",
        (table_name, f"%{keyword}%", limit)
    )
    rows = []
    for r in c.fetchall():
        d = dict(r)
        d["_id"] = r["id"]
        rows.append(d)
    conn.close()
    return rows

# 旧版兼容
def insert_record(date_str, category, item, amount, remark):
    return insert_table_row("每日流水", {
        "日期": date_str, "分类": category, "费用明细": item,
        "支出": str(amount), "收入": "", "银行余额": "", "备注": remark
    })

def query_records(date_str=None, limit=20):
    return query_table_rows("每日流水", limit)

def get_stats():
    rows = query_table_rows("每日流水", 1000)
    total_expense = sum(float(r.get("支出", 0) or 0) for r in rows)
    total_income = sum(float(r.get("收入", 0) or 0) for r in rows)
    cats = {}
    for r in rows:
        cat = r.get("分类", "其他")
        cats[cat] = cats.get(cat, 0) + 1
    return {
        "total_records": len(rows),
        "total_income": total_income,
        "total_expense": total_expense,
        "categories": [{"category": k, "count": v} for k, v in sorted(cats.items(), key=lambda x: -x[1])[:10]]
    }

def describe_table(table_name: str, include_sample: bool = True) -> dict:
    """返回指定表格的列结构、说明和示例数据，供 AI 插入前确认"""
    if table_name not in TABLE_SCHEMAS:
        return {"error": f"未知表格: {table_name}", "available_tables": list(TABLE_SCHEMAS.keys())}

    schema = TABLE_SCHEMAS[table_name]
    columns = schema["columns"]
    result = {
        "table_name": table_name,
        "description": schema.get("desc", ""),
        "columns": columns,
        "row_count": get_table_row_count(table_name)
    }

    if include_sample:
        # 取最近 3 条作为示例
        sample_rows = query_table_rows(table_name, limit=3)
        # 过滤掉内部字段
        clean_samples = []
        for r in sample_rows:
            clean = {k: v for k, v in r.items() if not k.startswith("_")}
            clean_samples.append(clean)
        result["sample_rows"] = clean_samples

    return result

# ============================================================================
# AI 多供应商调用（统一接口）
# ============================================================================
def call_ai(messages, tools=None, provider=None, model_id=None):
    """统一 AI 调用 — 根据当前配置或指定参数路由到不同供应商"""
    prov_key, mod_id = load_ai_config()
    if provider:
        prov_key = provider
    if model_id:
        mod_id = model_id

    prov = AI_PROVIDERS.get(prov_key)
    if not prov:
        return {"error": f"未知AI供应商: {prov_key}"}

    api_key = get_api_key(prov_key)
    if not api_key:
        return {"error": f"未配置 {prov['name']} API Key (环境变量 {prov['api_key_env']})"}

    base_url = get_base_url(prov_key)

    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }

    # 构建 payload — 兼容 OpenAI 格式
    temperature = 0.1
    payload = {
        "model": mod_id,
        "messages": messages,
        "temperature": temperature,
        "max_tokens": 4096,
        "top_p": 0.95,
    }
    if tools:
        payload["tools"] = tools
        payload["tool_choice"] = "auto"

    # 构建 URL — 兼容有无 /v1 前缀
    api_url = base_url.rstrip("/")
    if "/v1" not in api_url:
        api_url += "/v1"
    api_url += "/chat/completions"

    resp = requests.post(api_url, headers=headers, json=payload, timeout=120)
    if resp.status_code != 200:
        return {"error": f"{prov['name']} API {resp.status_code}: {resp.text[:300]}"}
    return resp.json()

# 兼容旧代码
def call_deepseek(messages, tools=None):
    return call_ai(messages, tools)

def parse_dsml_tool_calls(content: str) -> list:
    """解析 DeepSeek-R1 等模型在回复文本中输出的 DSML/XML 风格工具调用。

    不依赖精确的分隔符字符（如 <｜｜DSML｜｜），只匹配 invoke/parameter 结构，
    对不同的字符变体（全角竖线、半角等）都鲁棒。
    """
    if not content or "invoke name=" not in content:
        return []

    calls = []
    # 匹配每个 invoke 块：invoke name="x">...</\S*invoke>
    for m in re.finditer(r'invoke\s+name="([^"]+)"\s*>(.*?)</\S*invoke>', content, re.DOTALL):
        name = m.group(1)
        body = m.group(2)
        args = {}
        # 匹配每个 parameter 块
        for pm in re.finditer(
            r'parameter\s+name="([^"]+)"\s+string="(?:true|false)"\s*>(.*?)</\S*parameter>',
            body, re.DOTALL
        ):
            pname = pm.group(1)
            pval = pm.group(2).strip()
            try:
                pval = json.loads(pval)
            except Exception:
                pass
            args[pname] = pval
        calls.append({"name": name, "arguments": args})
    return calls

# ---------------------------------------------------------------------------
# Excel/图片解析
# ---------------------------------------------------------------------------
def parse_excel(file_bytes, filename):
    try:
        wb = load_workbook(io.BytesIO(file_bytes), data_only=True)
        all_text = []
        for sn in wb.sheetnames:
            ws = wb[sn]
            all_text.append(f"## 工作表: {sn}")
            rows_list = list(ws.iter_rows(values_only=True))
            if not rows_list:
                all_text.append("(空)")
                continue
            for i, row in enumerate(rows_list):
                cells = [str(c) if c is not None else "" for c in row]
                all_text.append(" | ".join(cells))
                if i == 0 and len(rows_list) > 1:
                    all_text.append("|".join(["---"] * len(cells)))
        return "\n".join(all_text)
    except Exception as e:
        return f"[Excel 解析失败: {e}]"

def parse_image(file_bytes):
    try:
        img = Image.open(io.BytesIO(file_bytes))
        info = {"格式": img.format, "尺寸": f"{img.width}x{img.height}", "模式": img.mode}
        try:
            exif = img.getexif()
            for tid, val in exif.items():
                from PIL.ExifTags import TAGS
                tag = TAGS.get(tid, tid)
                if tag in ("DateTime", "Make", "Model"):
                    info[tag] = str(val)
        except:
            pass
        return {"text": "\n".join(f"{k}: {v}" for k, v in info.items()), "info": info}
    except Exception as e:
        return {"text": f"[图片解析失败: {e}]", "info": {}}

