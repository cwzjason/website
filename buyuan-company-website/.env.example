# ===== 数据库配置 (MariaDB) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=buqin_business
DB_CONNECTION_LIMIT=20

# ===== JWT 密钥 =====
JWT_SECRET=change-this-to-a-random-secret

# ===== 腾讯混元 TokenHub API =====
TENCENT_TOKENHUB_API_KEY=your-tokenhub-api-key

# ===== 修改数据存储规则所需密码 =====
DB_RULE_PASSWORD=your-rule-password

# ===== 服务端口 =====
PORT=3000
